# =================================================================
# Copy to .env and fill in. NEVER commit .env.
# This file is the source of truth for env var names — every variable
# here is read by code; add new ones here first.
#
# ONLY THE FOUR ACTIVE LINES BELOW ARE REQUIRED. Everything commented
# out is an optional fallback for headless/automated deploys — the
# admin settings pages are the primary home for all credentials
# (Stripe, mailbox, Google service account) and identity, and
# admin-stored values always win over env.
# =================================================================

# Generate with: openssl rand -base64 32
# Also keys the AES-256-GCM encryption of admin-stored credentials —
# rotating it invalidates stored Stripe/mailbox/Google secrets
# (re-paste them in the admin after a rotation).
PAYLOAD_SECRET=

# Postgres. Local Homebrew/docker, or Neon/Supabase connection string.
# Managed providers usually require ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ecommerce

# The shop's public origin. Drives canonicals, sitemap, OG/schema URLs
# and email links — production MUST set the real domain (https://…).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authorizes draft preview links from the admin.
PREVIEW_SECRET=

# --- Optional: tests --------------------------------------------
# Integration tests default to "<DATABASE_URL database>_test"; override
# the full test connection string only if that scheme doesn't fit.
# TEST_DATABASE_URL=

# --- Optional fallback: Stripe ----------------------------------
# Primary: Settings -> Stripe -> API keys (write-only, encrypted).
# Live keys belong in the host's secret store, never a committed file.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOKS_SIGNING_SECRET=

# --- Optional fallback: Google Merchant API ---------------------
# Primary: Settings -> Google Merchant Center -> Service account
# (write-only, encrypted). Merchant ID, markets and dry-run also live
# there. Env fallback: path to the JSON key file, or base64 of the
# whole file for hosts without a filesystem.
# NOTE: Merchant API, NOT the Content API (shuts down 2026-08-18).
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# --- Optional fallback: Email (SMTP/IMAP mailbox) ---------------
# Primary: Settings -> Email (write-only passwords, encrypted).
# Any mailbox with app-password SMTP/IMAP works.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# IMAP defaults to the SMTP host/credentials; override if they differ.
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
